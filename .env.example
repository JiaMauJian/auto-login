# 把這個檔案複製成 .env，填入自己的帳密後即可使用。
# .env 要跟 login.py（或打包後的 tbb-login.exe）放在同一層資料夾。

# ---- 帳號 ----
# 可設定多組，依序編號 _1、_2、_3...，程式會每組各開一個分頁自動登入。
TBB_ID_1=your_id_number_1
TBB_PASSWORD_1=your_password_1

TBB_ID_2=your_id_number_2
TBB_PASSWORD_2=your_password_2

# ---- 瀏覽器 ----

# 用哪個瀏覽器：chrome、msedge...。留空則用 Playwright 自己下載的 Chromium
# （第一次執行會自動下載約 150MB）。
BROWSER_CHANNEL=chrome

# 使用者資料夾，tbbstock 的數位憑證與 Cookie 存在這裡；留空則每次都開全新的空白 profile
# （憑證也就存不住，登入後會被「瀏覽器查無有效數位憑證」擋下來）。
# 相對路徑以本檔案所在資料夾為基準。
#
# 設好之後執行一次 setup-profile.ps1 把資料夾建出來（視窗直接關掉，不用登入任何帳號），
# 再用 migrate-cert.ps1 把憑證複製進來。
# 每台電腦都要各做一次 —— 這個資料夾不能從別台電腦複製過來，Chrome 的加密會讓它失效。
# 也不能指向 %LOCALAPPDATA%\Google\Chrome\User Data，Chrome 會拒絕自動化連線。
USER_DATA_DIR=chrome-profile

# 上面資料夾底下要用哪個設定檔（Default、Profile 1...），留空就是 Default。
# 只有在同一個資料夾裡分了多個 Chrome 使用者才需要設。
# BROWSER_PROFILE_DIR=Default

# 直接指定瀏覽器執行檔路徑（會蓋過 BROWSER_CHANNEL），一般不用設。
# BROWSER_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# 可設定多組帳號，依序編號：TBB_ID_1/TBB_PASSWORD_1、TBB_ID_2/TBB_PASSWORD_2...
# login.py 會依序讀取每一組帳號，各自開一個瀏覽器視窗（同一個瀏覽器程式、各自獨立 context）登入。
TBB_ID_1=your_id_number_1
TBB_PASSWORD_1=your_password_1

TBB_ID_2=your_id_number_2
TBB_PASSWORD_2=your_password_2

# 是否填完就直接送出登入。
# true（預設）：自動填完帳密與驗證碼後直接按下登入。
# false：全部填完後停在終端機等你按 Enter，可先人工核對，再一次送出所有帳號。
AUTO_SUBMIT=true
